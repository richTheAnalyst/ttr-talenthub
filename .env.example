APP_NAME="TTR TalentHub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL) -------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ttr_talenthub
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Neon / hosted Postgres: comment the DB_* lines above and use one URL instead.
# DB_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Sessions, cache, queues (all database-backed: no Redis needed) --------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (log driver writes emails to storage/logs in development) --------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="talenthub@ttr.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- TalentHub -------------------------------------------------------------
# Seeded administrator (change the password before going live).
ADMIN_EMAIL=admin@ttr.test
ADMIN_PASSWORD="ChangeMe!2026"

# Optional CRM automation: every new/updated lead is POSTed here by a queued job.
TALENTHUB_CRM_WEBHOOK_URL=
TALENTHUB_CRM_WEBHOOK_SECRET=

# Sanctum API tokens expire after this many minutes (blank = never).
SANCTUM_TOKEN_EXPIRATION=43200

#WHATSAPP_NUMBER
WHATSAPP_NUMBER="233245646788"